{
  "name": "ominx-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OminX Engine \u2014 a complete browser-native 3D game engine, editor (Studio) and multiplayer runtime.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test tests/*.test.js",
    "server": "node server/bin/ominx-server.js",
    "headless": "node server/bin/ominx-headless.js",
    "core": "node tools/core-report.mjs",
    "core:json": "node tools/core-report.mjs --json --quiet",
    "check": "node tools/syntax-check.js",
    "test:watch": "node --test --watch tests/*.test.js"
  },
  "devDependencies": {
    "monaco-editor": "^0.57.0",
    "vite": "^8.3.4",
    "wgsl_reflect": "^1.6.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
